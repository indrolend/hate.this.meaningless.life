{
  "name": "datafactory",
  "displayName": "hate.this.meaningless.life",
  "description": "funny.html: a small copy, run, read, copy command HUD.",
  "version": "0.6.0",
  "publisher": "indrolend",
  "license": "MIT",
  "files": [
    "src/**",
    "media/**",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:dataFactory.open"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dataFactory.open",
        "title": "funny: Open"
      },
      {
        "command": "dataFactory.refresh",
        "title": "funny: Refresh"
      },
      {
        "command": "dataFactory.status",
        "title": "funny: Status"
      },
      {
        "command": "dataFactory.openProject",
        "title": "funny: Project"
      },
      {
        "command": "dataFactory.clone",
        "title": "funny: Clone"
      }
    ],
    "configuration": {
      "title": "hate.this.meaningless.life",
      "properties": {
        "dataFactory.openOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open funny.html with the workspace."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check src/extension.js && node --check src/core.js && node --check media/funny.js",
    "test": "node --test tests/*.test.js",
    "verify": "npm run check && npm test",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  }
}
